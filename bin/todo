#!/usr/bin/env bash
set -euo pipefail

priorities="$HOME/.knowledge-hub/priorities.md"
if [[ ! -f "$priorities" ]]; then
  printf 'Priorities file not found: %s\n' "$priorities" >&2
  exit 1
fi

if (($# == 0)); then
  awk '/^### / { printf "%d. %s\n", ++count, substr($0, 5) }' "$priorities"
  exit 0
fi

total=$(awk '/^### / { count++ } END { print count+0 }' "$priorities")
declare -A selected=()
for arg in "$@"; do
  if [[ $arg =~ ^([0-9]+)-([0-9]+)$ ]]; then
    first=${BASH_REMATCH[1]}
    last=${BASH_REMATCH[2]}
    if ((first < 1 || last < first || last > total)); then
      printf 'Invalid task range: %s (valid tasks: 1-%s)\n' "$arg" "$total" >&2
      exit 1
    fi
    for ((i=first; i<=last; i++)); do selected[$i]=1; done
  elif [[ $arg =~ ^[0-9]+$ ]] && ((arg >= 1 && arg <= total)); then
    selected[$arg]=1
  else
    printf 'Invalid task number or range: %s (valid tasks: 1-%s)\n' "$arg" "$total" >&2
    exit 1
  fi
done

selection=$(printf '%s\n' "${!selected[@]}" | sort -n | paste -sd, -)
awk -v selection="$selection" '
  BEGIN { count = split(selection, numbers, ","); for (i=1; i<=count; i++) wanted[numbers[i]]=1 }
  function finish() {
    if (entry != "" && wanted[idx]) printf "%d. %s\n", idx, entry
  }
  /^### / { finish(); idx++; entry=$0 "\n"; next }
  /^## / { finish(); entry=""; next }
  entry != "" { entry=entry $0 "\n" }
  END { finish() }
' "$priorities"
