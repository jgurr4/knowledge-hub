#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == todo ]]; then
  shift
  priorities="$HOME/.knowledge-hub/priorities.md"
  if [[ ! -f "$priorities" ]]; then
    printf 'Priorities file not found: %s\n' "$priorities" >&2
    exit 1
  fi

  if (($# == 0)); then
    awk '/^### / { printf "%d. %s\n", ++count, substr($0, 5) }' "$priorities"
    exit 0
  fi

  total=$(awk '/^### / { count++ } END { print count+0 }' "$priorities")
  declare -A selected=()
  for arg in "$@"; do
    if [[ $arg =~ ^([0-9]+)-([0-9]+)$ ]]; then
      first=${BASH_REMATCH[1]}
      last=${BASH_REMATCH[2]}
      if ((first < 1 || last < first || last > total)); then
        printf 'Invalid task range: %s (valid tasks: 1-%s)\n' "$arg" "$total" >&2
        exit 1
      fi
      for ((i=first; i<=last; i++)); do selected[$i]=1; done
    elif [[ $arg =~ ^[0-9]+$ ]] && ((arg >= 1 && arg <= total)); then
      selected[$arg]=1
    else
      printf 'Invalid task number or range: %s (valid tasks: 1-%s)\n' "$arg" "$total" >&2
      exit 1
    fi
  done

  selection=$(printf '%s\n' "${!selected[@]}" | sort -n | paste -sd, -)
  awk -v selection="$selection" '
    BEGIN { count = split(selection, numbers, ","); for (i=1; i<=count; i++) wanted[numbers[i]]=1 }
    function finish() {
      if (entry != "" && wanted[idx]) printf "%d. %s\n", idx, entry
    }
    /^### / { finish(); idx++; entry=$0 "\n"; next }
    /^## / { finish(); entry=""; next }
    entry != "" { entry=entry $0 "\n" }
    END { finish() }
  ' "$priorities"
  exit 0
fi

if [[ ${1:-} == search ]]; then
  shift
  daily_dir="$HOME/.knowledge-hub/dailynotes"
  shopt -s nullglob
  notes=("$daily_dir"/*.md)
  if ((${#notes[@]} == 0)); then
    printf 'No daily notes found in %s\n' "$daily_dir" >&2
    exit 1
  fi

  if (($# > 0)) && [[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    start=$1
    end=$start
    shift
    if (($# > 0)) && [[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
      end=$1
      shift
    fi
    if ! date -j -f '%Y-%m-%d' "$start" +%F >/dev/null 2>&1 ||
       ! date -j -f '%Y-%m-%d' "$end" +%F >/dev/null 2>&1 || [[ $end < $start ]]; then
      printf 'Usage: note search [YYYY-MM-DD [YYYY-MM-DD]] [text]\n' >&2
      exit 1
    fi
    selected=()
    for note in "${notes[@]}"; do
      day=${note##*/}
      day=${day%.md}
      [[ $day < $start || $day > $end ]] || selected+=("$note")
    done
    notes=("${selected[@]}")
  fi

  if (($# == 0)); then
    for note in "${notes[@]}"; do
      printf '\n### %s\n' "${note##*/}"
      cat "$note"
    done
  elif ((${#notes[@]})); then
    grep -inH -F -- "$*" "${notes[@]}" || [[ $? == 1 ]]
  fi
  exit 0
fi

script_path=$0
while [[ -L "$script_path" ]]; do
  link_dir=$(cd -P "$(dirname "$script_path")" >/dev/null 2>&1 && pwd)
  link_target=$(readlink "$script_path")
  [[ $link_target == /* ]] || link_target="$link_dir/$link_target"
  script_path=$link_target
done
repo_root=$(cd -P "$(dirname "$script_path")/.." >/dev/null 2>&1 && pwd)
local_dir="$HOME/.knowledge-hub"
daily_dir="$local_dir/dailynotes"
today=$(date +%F)
notes_file="$daily_dir/$today.md"
lock_dir="$local_dir/.note.lock"
tmp_file=$(mktemp "${TMPDIR:-/tmp}/knowledge-hub-note.XXXXXX")

cleanup() {
  rm -f "$tmp_file"
  rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

mkdir -p "$daily_dir"

editor=${VISUAL:-${EDITOR:-vim}}
read -r -a editor_cmd <<< "$editor"
"${editor_cmd[@]}" "$tmp_file"

if [[ ! -s "$tmp_file" ]] || [[ -z "$(tr -d '[:space:]' < "$tmp_file")" ]]; then
  printf '%s\n' 'No note saved.'
  exit 0
fi

while ! mkdir "$lock_dir" 2>/dev/null; do
  sleep 0.05
done

{
  printf '## %s\n\n' "$(date +%T)"
  cat "$tmp_file"
  printf '\n\n'
} >> "$notes_file"
printf 'Note saved to %s\n' "$notes_file"
